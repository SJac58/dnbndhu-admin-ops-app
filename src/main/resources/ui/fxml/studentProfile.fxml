<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.org.dnbndhu.ui.controller.StudentProfileController"
            styleClass="main-container">

    <left>
        <fx:include source="sidebar.fxml"/>
    </left>

    <center>
        <ScrollPane fx:id="profileScroll" fitToWidth="true">
            <VBox spacing="24" styleClass="page-root">
                <padding>
                    <Insets top="25" right="40" bottom="25" left="40"/>
                </padding>

                <!-- ===== STUDENT + PERSONAL DETAILS ROW ===== -->
                <HBox spacing="30" alignment="TOP_LEFT">

                    <!-- Student Card -->
                    <VBox spacing="14" styleClass="student-card">
                        <StackPane fx:id="photoBox"
                                   styleClass="photo-box"
                                   maxWidth="-Infinity"
                                   maxHeight="-Infinity"/>

                        <Label fx:id="nameLabel"
                               styleClass="profile-name"/>

                        <HBox spacing="20" alignment="CENTER">
                            <Label fx:id="ageGenderLabel"
                                   styleClass="profile-sub"/>

                            <Label fx:id="studentIdLabel"
                                   styleClass="pill"/>
                        </HBox>
                    </VBox>

                    <!-- Personal Details Card -->
                    <VBox styleClass="card" prefWidth="600">
                        <Label text="Personal Details" styleClass="section-title"/>

                        <GridPane hgap="20" vgap="10">
                            <Label text="Date of Birth:"/>
                            <Label fx:id="dobLabel" GridPane.columnIndex="1"/>

                            <Label text="Disability:" GridPane.rowIndex="1"/>
                            <Label fx:id="disabilityLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <Label text="Marital Status:" GridPane.rowIndex="2"/>
                            <Label fx:id="maritalStatusLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                            <Label text="Religion:" GridPane.rowIndex="3"/>
                            <Label fx:id="religionLabel" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                            <Label text="Caste:" GridPane.rowIndex="4"/>
                            <Label fx:id="casteLabel" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                            <Label text="Sub Caste:" GridPane.rowIndex="5"/>
                            <Label fx:id="subCasteLabel" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                        </GridPane>
                    </VBox>

                </HBox>
                <!-- ===== CONTACT DETAILS ===== -->
                <VBox styleClass="card">
                    <Label text="Contact Details" styleClass="section-title"/>

                    <GridPane hgap="20" vgap="10">

                        <Label text="Email:"/>
                        <Label fx:id="emailLabel" GridPane.columnIndex="1"/>

                        <Label text="Phone:" GridPane.rowIndex="1"/>
                        <Label fx:id="phoneLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Address:" GridPane.rowIndex="2"/>
                        <Label fx:id="addressLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="District:" GridPane.rowIndex="3"/>
                        <Label fx:id="districtLabel" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                        <Label text="Taluq:" GridPane.rowIndex="4"/>
                        <Label fx:id="taluqLabel" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                        <Label text="Village:" GridPane.rowIndex="5"/>
                        <Label fx:id="villageLabel" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                        <Label text="PIN Code:" GridPane.rowIndex="6"/>
                        <Label fx:id="pinCodeLabel" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                    </GridPane>
                </VBox>

                <!-- ===== ID DETAILS ===== -->
                <VBox styleClass="card">
                    <Label text="Identification" styleClass="section-title"/>

                    <GridPane hgap="20" vgap="10">

                        <Label text="Aadhaar:"/>
                        <Label fx:id="aadhaarLabel" GridPane.columnIndex="1"/>

                        <Label text="PAN:" GridPane.rowIndex="1"/>
                        <Label fx:id="panLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    </GridPane>
                </VBox>

                <!-- ===== ENROLLMENT ===== -->
                <VBox styleClass="card">
                    <Label text="Enrollment Info" styleClass="section-title"/>

                    <GridPane hgap="20" vgap="10">

                        <Label text="Batch ID:"/>
                        <Label fx:id="batchIdLabel" GridPane.columnIndex="1"/>

                        <Label text="Enrollment Date:" GridPane.rowIndex="1"/>
                        <Label fx:id="enrollmentDateLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Referral Source:" GridPane.rowIndex="2"/>
                        <Label fx:id="referralLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Prior Training:" GridPane.rowIndex="3"/>
                        <Label fx:id="priorTrainingLabel" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    </GridPane>
                </VBox>

                <!-- ===== ATTENDANCE ===== -->
                <VBox styleClass="card">
                    <Label text="Attendance Overview" styleClass="section-title"/>

                    <ProgressBar fx:id="attendanceBar" prefWidth="300"/>
                    <Label fx:id="attendanceText"/>
                </VBox>

                <!-- ===== DOCUMENTS ===== -->
                <VBox styleClass="card">

                    <Label text="Documents" styleClass="section-title"/>

                    <VBox spacing="8">
                        <Button fx:id="viewAadhaarBtn"
                                text="View Aadhaar"/>

                        <Button fx:id="viewPanBtn"
                                text="View PAN"/>

                        <Button fx:id="viewBankBtn"
                                text="View Bank Passbook"/>

                        <Button fx:id="viewEducationalCertBtn"
                                text="View Educational Certification"/>

                        <Button fx:id="viewMedicalCertBtn"
                                text="View Medical Certificate"/>

                        <Button fx:id="viewUdidBtn"
                                text="View UDID"/>

                        <Button fx:id="viewPhotoBtn"
                                text="View Photo"/>


                    </VBox>

                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>