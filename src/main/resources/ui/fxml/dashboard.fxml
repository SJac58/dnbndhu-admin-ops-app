<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.org.dnbndhu.ui.controller.DashboardController"
            styleClass="main-container">

    <!-- Sidebar -->
    <left>
        <fx:include source="sidebar.fxml"/>
    </left>

    <!-- Main Content -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="content-scroll">
            <VBox spacing="40">
                <padding>
                    <Insets top="30" right="60" bottom="40" left="60"/>
                </padding>

                <!-- Header -->
                <HBox alignment="CENTER_LEFT">
                    <Label text="Student Analytics" styleClass="header-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="🔔" styleClass="icon-button"/>
                </HBox>

                <!-- Hero -->
                <StackPane>
                    <Circle radius="100" styleClass="hero-circle"/>
                    <VBox alignment="CENTER">
                        <Label fx:id="totalStudentsLabel"
                               text="0"
                               styleClass="hero-count"/>
                        <Label text="STUDENTS ENROLLED"
                               styleClass="hero-subtext"/>
                    </VBox>
                </StackPane>

                <!-- GRID -->
                <GridPane hgap="40" vgap="60">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                    </columnConstraints>

                    <!-- ROW 1 -->

                    <!-- Demographics -->
                    <VBox GridPane.columnIndex="0"
                          GridPane.rowIndex="0"
                          styleClass="card"
                          spacing="15">

                        <Label text="Demographics"
                               styleClass="card-title"/>

                        <PieChart fx:id="demographicsChart"
                                  VBox.vgrow="ALWAYS"
                                  prefHeight="320"/>
                    </VBox>

                    <!-- Age Distribution -->
                    <VBox GridPane.columnIndex="1"
                          GridPane.rowIndex="0"
                          styleClass="card"
                          spacing="15">

                        <Label text="Age Distribution of Students"
                               styleClass="card-title"/>

                        <VBox fx:id="educationBox"
                              VBox.vgrow="ALWAYS"/>
                    </VBox>

                    <!-- ROW 2 -->

                    <!-- Participation -->
                    <VBox GridPane.columnIndex="0"
                          GridPane.rowIndex="1"
                          styleClass="card"
                          spacing="15">

                        <Label text="Participation per Program"
                               styleClass="card-title"/>

                        <BarChart fx:id="participationChart"

                                  prefHeight="320">


                            <xAxis>
                                <NumberAxis/>
                            </xAxis>
                            <yAxis>
                                <CategoryAxis/>
                            </yAxis>

                        </BarChart>
                    </VBox>

                    <!-- Program Comparison (Replaces Outreach) -->
                    <VBox GridPane.columnIndex="1"
                          GridPane.rowIndex="1"
                          styleClass="card"
                          spacing="15">

                        <Label text="Program Comparison Over Time"
                               styleClass="card-title"/>

                        <LineChart fx:id="programComparisonChart"
                                   VBox.vgrow="ALWAYS"
                                   prefHeight="320"
                                   style="-fx-padding: 10 0 0 0;">

                            <xAxis>
                                <CategoryAxis/>
                            </xAxis>
                            <yAxis>
                                <NumberAxis/>
                            </yAxis>

                        </LineChart>
                    </VBox>

                    <!-- ROW 3 (FULL WIDTH) -->

                    <VBox GridPane.columnIndex="0"
                          GridPane.rowIndex="2"
                          GridPane.columnSpan="2"
                          styleClass="card"
                          spacing="15">

                        <Label text="Enrollment Trend"
                               styleClass="card-title"/>

                        <LineChart fx:id="enrollmentChart"
                                   VBox.vgrow="ALWAYS"
                                   prefHeight="420">

                            <xAxis>
                                <CategoryAxis/>
                            </xAxis>
                            <yAxis>
                                <NumberAxis/>
                            </yAxis>

                        </LineChart>

                    </VBox>

                </GridPane>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>